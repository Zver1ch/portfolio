{
	"name": "portfolio",
	"version": "1.0.2",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"build-start": "next build && next start",
		"tsc": "tsc --noEmit",
		"lint": "biome check --write .",
		"lint-unsafe": "biome check --write --unsafe .",
		"lint:ci": "biome check .",
		"verify": "pnpm lint:ci && pnpm tsc && pnpm run fsd && pnpm test && pnpm assets:check",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"fsd": "steiger ./src",
		"assets:model": "node scripts/build-model.mjs",
		"assets:inspect": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/inspect-model.mjs",
		"assets:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-assets.mjs",
		"assets:shots": "node scripts/shots.mjs",
		"generate-api": "openapi-ts",
		"postinstall": "lefthook install",
		"assets:posters": "node scripts/capture-posters.mjs",
		"assets:page-shots": "node scripts/page-shots.mjs"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"@gsap/react": "^2.1.2",
		"@t3-oss/env-nextjs": "^0.13.11",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"gsap": "^3.15.0",
		"lenis": "^1.3.26",
		"lucide-react": "^1.50.0",
		"next": "16.3.8",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"shadcn": "^4.21.1",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.7.0",
		"three": "0.186.1",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@feature-sliced/steiger-plugin": "^0.8.0",
		"@playwright/test": "^1.63.0",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/typography": "^0.5.20",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.6.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/three": "0.186.0",
		"@vitejs/plugin-react": "^6.1.1",
		"@vitest/coverage-v8": "^5.0.3",
		"babel-plugin-react-compiler": "^1.0.0",
		"jsdom": "^30.1.1",
		"lefthook": "^2.1.16",
		"steiger": "^0.7.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	},
	"packageManager": "pnpm@11.28.3",
	"engines": {
		"node": ">=24"
	}
}
